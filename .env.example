# ============================================================
#  SearchGPT — пример конфигурации
#  Скопируйте этот файл в .env и заполните своими значениями:
#      cp .env.example .env
# ============================================================

# --- Google Custom Search API -------------------------------
GOOGLE_API_KEY=ваш_google_api_key
GOOGLE_CX_ID=ваш_id_поисковика_cx

# --- Google OAuth 2.0 (вход через Google аккаунт) -----------
# Создать: https://console.cloud.google.com/apis/credentials
# Тип: "Веб-приложение". Redirect URI ДОЛЖЕН точно совпадать с адресом,
# по которому вы открываете сайт (см. PUBLIC_BASE_URL ниже).
# Для локального запуска добавьте в консоли ВСЕ варианты:
#   http://localhost:4000/auth/callback
#   http://127.0.0.1:4000/auth/callback
GOOGLE_CLIENT_ID=ваш_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ваш_client_secret

# Публичный адрес приложения (для OAuth redirect_uri). Оставьте пустым для
# http://localhost:4000. Если заходите через ngrok/cloudflared или по IP —
# укажите полный адрес, например:
#   PUBLIC_BASE_URL=https://abc123.ngrok-free.app
#   PUBLIC_BASE_URL=http://192.168.1.50:4000
# Текущий redirect_uri всегда можно посмотреть на /auth/redirect-uri
PUBLIC_BASE_URL=

# --- Безопасность сессии ------------------------------------
SECRET_KEY=случайная_длинная_строка_например_openssl_rand_hex_32

# --- AI-ответ (Pollinations.AI) -----------------------------
# Бесплатный OpenAI-совместимый API, ключ НЕ требуется: https://pollinations.ai
AI_ENABLED=1                # 0 — отключить блок «Ответ ИИ»
POLLINATIONS_URL=https://text.pollinations.ai
POLLINATIONS_MODEL=openai   # также: mistral, llama, deepseek и др. (см. /v1/models)

# --- Сервер --------------------------------------------------
PORT=4000

# --- API-ключи для программного доступа (/api/v1/search) ----
# Список ключей через запятую. Клиент передаёт их как
#   Authorization: Bearer sk-...   или   ?key=sk-...
# Сгенерируйте свои, например: openssl rand -hex 24
SEARCH_API_KEYS=sk-test-1234567890abcdef
